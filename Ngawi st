                specs: "Standar distro lokal, adem dan nyaman digunakan kapan saja.",
                stock: 30,
                image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80"
            }
        ];

        let cart = [];
        let currentFilter = 'all';

        // Load saved products from LocalStorage if any
        if(localStorage.getItem('rns_products')) {
            try {
                products = JSON.parse(localStorage.getItem('rns_products'));
            } catch(e) {
                console.error("Error loading local products", e);
            }
        }

        // Initialize App on Load
        window.onload = function() {
            renderProducts();
        };

        // Navigation Switch Tabs
        function switchTab(tabId) {
            document.getElementById('tab-catalog').classList.add('hidden');
            document.getElementById('tab-input-stok').classList.add('hidden');
            document.getElementById('tab-pembayaran').classList.add('hidden');
            document.getElementById('tab-kontak').classList.add('hidden');

            if(tabId === 'catalog') {
                document.getElementById('tab-catalog').classList.remove('hidden');
            } else if(tabId === 'input-stok') {
                document.getElementById('tab-input-stok').classList.remove('hidden');
            } else if(tabId === 'pembayaran') {
                document.getElementById('tab-pembayaran').classList.remove('hidden');
            } else if(tabId === 'kontak') {
                document.getElementById('tab-kontak').classList.remove('hidden');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        // Toast Notification
        function showToast(message, iconClass = "fa-solid fa-check-circle text-green-400") {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            msgEl.innerText = message;
            iconEl.className = iconClass + " text-lg";

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        // Render Products
        function renderProducts(filteredList = null) {
            const grid = document.getElementById('product-grid');
            grid.innerHTML = '';

            const listToRender = filteredList || products;

            if(listToRender.length === 0) {
                grid.innerHTML = `<div class="col-span-full py-12 text-center text-gray-500">Tidak ada produk yang ditemukan.</div>`;
                return;
            }

            listToRender.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-white rounded-3xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden flex flex-col justify-between group";
                card.innerHTML = `
                    <div class="relative h-56 bg-gray-100 overflow-hidden cursor-pointer" onclick="openProductModal(${p.id})">
                        <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://placehold.co/600x400/indigo/white?text=Rong+Ngawi+St'">
                        <span class="absolute top-3 left-3 bg-indigo-600/90 backdrop-blur-md text-white text-xs font-bold px-3 py-1 rounded-full shadow">${p.category}</span>
                        <span class="absolute top-3 right-3 bg-white/90 backdrop-blur-md text-gray-800 text-xs font-bold px-2.5 py-1 rounded-full shadow">Stok: ${p.stock}</span>
                    </div>
                    <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
                        <div>
                            <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wider">${p.brand}</span>
                            <h4 onclick="openProductModal(${p.id})" class="font-bold text-gray-900 text-base line-clamp-1 cursor-pointer hover:text-indigo-600 transition">${p.name}</h4>
                            <p class="text-xs text-gray-500 mt-1 line-clamp-2">${p.specs}</p>
                        </div>
                        <div class="pt-2 border-t flex items-center justify-between">
                            <div>
                                <span class="text-xs text-gray-400 block">Harga</span>
                                <span class="font-extrabold text-indigo-600 text-lg">Rp ${p.price.toLocaleString('id-ID')}</span>
                            </div>
                            <button onclick="addToCart(${p.id})" class="bg-indigo-50 hover:bg-indigo-600 text-indigo-600 hover:text-white p-3 rounded-xl transition shadow-sm" title="Tambah ke Keranjang">
                                <i class="fa-solid fa-cart-plus"></i>
                            </button>
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Filter Category
        function filterCategory(cat) {
            currentFilter = cat;
            
            // Update button styles
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.className = "category-btn px-5 py-2.5 rounded-xl text-sm font-semibold whitespace-nowrap bg-white text-gray-600 border border-gray-200 hover:bg-gray-50 transition";
            });
            const activeBtn = document.getElementById('cat-' + cat);
            if(activeBtn) {
                activeBtn.className = "category-btn active px-5 py-2.5 rounded-xl text-sm font-semibold whitespace-nowrap bg-indigo-600 text-white shadow-md shadow-indigo-100 transition";
            }

            if(cat === 'all') {
                renderProducts();
            } else {
                const filtered = products.filter(p => p.category === cat);
                renderProducts(filtered);
            }
        }

        // Search Handler
        function handleSearch() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const filtered = products.filter(p => 
                (currentFilter === 'all' || p.category === currentFilter) &&
                (p.name.toLowerCase().includes(query) || p.brand.toLowerCase().includes(query) || p.specs.toLowerCase().includes(query))
            );
            renderProducts(filtered);
        }

        // Handle Add New Product (Input Stok Baru)
        function handleAddNewProduct(e) {
            e.preventDefault();
            const newProd = {
                id: Date.now(),
                name: document.getElementById('new-name').value,
                category: document.getElementById('new-category').value,
                price: parseInt(document.getElementById('new-price').value),
                size: document.getElementById('new-size').value,
                brand: document.getElementById('new-brand').value,
                specs: document.getElementById('new-specs').value,
                stock: parseInt(document.getElementById('new-stock').value),
                image: document.getElementById('new-image').value
            };

            products.unshift(newProd);
            localStorage.setItem('rns_products', JSON.stringify(products));

            document.getElementById('add-product-form').reset();
            showToast("Stok baru berhasil ditambahkan ke etalase!");
            switchTab('catalog');
            filterCategory('all');
        }

        // Product Modal Detail
        let activeModalProductId = null;
        function openProductModal(id) {
            const p = products.find(item => item.id === id);
            if(!p) return;
            activeModalProductId = id;

            document.getElementById('modal-img').src = p.image;
            document.getElementById('modal-category').innerText = p.category;
            document.getElementById('modal-brand').innerText = p.brand;
            document.getElementById('modal-title').innerText = p.name;
            document.getElementById('modal-price').innerText = `Rp ${p.price.toLocaleString('id-ID')}`;
            document.getElementById('modal-stock').innerText = `Stok: ${p.stock}`;
            document.getElementById('modal-size').innerText = p.size;
            document.getElementById('modal-specs').innerText = p.specs;
            document.getElementById('modal-add-btn').setAttribute('onclick', `addToCart(${p.id}); closeProductModal();`);

            document.getElementById('product-modal').classList.remove('hidden');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        function orderViaWAFromModal() {
            const p = products.find(item => item.id === activeModalProductId);
            if(!p) return;
            const text = `Halo Admin Rong Ngawi St, saya ingin memesan produk berikut:\n\n*${p.name}*\nMerk: ${p.brand}\nHarga: Rp ${p.price.toLocaleString('id-ID')}\nUkuran: ${p.size}\n\nMohon informasi ketersediaannya. Terima kasih.`;
            window.open(`https://wa.me/6282115172928?text=${encodeURIComponent(text)}`, '_blank');
        }

        // Cart Management
        function addToCart(id) {
            const p = products.find(item => item.id === id);
            if(!p) return;

            const existing = cart.find(item => item.id === id);
            if(existing) {
                if(existing.qty < p.stock) {
                    existing.qty++;
                } else {
                    showToast("Stok maksimum tercapai!", "fa-solid fa-triangle-exclamation text-yellow-400");
                    return;
                }
            } else {
                cart.push({ ...p, qty: 1 });
            }

            updateCartBadge();
            showToast(`Berhasil menambahkan ${p.name} ke keranjang!`);
        }

        function updateCartBadge() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cart-count').innerText = totalCount;
        }

        function openCartModal() {
            renderCartItems();
            document.getElementById('cart-modal').classList.remove('hidden');
        }

        function closeCartModal() {
            document.getElementById('cart-modal').classList.add('hidden');
        }

        function renderCartItems() {
            const container = document.getElementById('cart-items-container');
            container.innerHTML = '';

            if(cart.length === 0) {
                container.innerHTML = `<div class="py-12 text-center text-gray-500"><i class="fa-solid fa-bag-shopping text-4xl text-gray-300 mb-3"></i><p>Keranjang belanja Anda masih kosong.</p></div>`;
                document.getElementById('cart-total-price').innerText = "Rp 0";
                return;
            }

            let totalPrice = 0;

            cart.forEach((item, index) => {
                totalPrice += item.price * item.qty;
                const row = document.createElement('div');
                row.className = "flex items-center justify-between bg-gray-50 p-4 rounded-2xl border";
                row.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 object-cover rounded-xl">
                        <div>
                            <h4 class="font-bold text-gray-900 text-sm">${item.name}</h4>
                            <p class="text-xs text-indigo-600 font-semibold">Rp ${item.price.toLocaleString('id-ID')}</p>
                            <p class="text-xs text-gray-500">Ukuran: ${item.size}</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3">
                        <div class="flex items-center space-x-2 bg-white border rounded-lg px-2 py-1">
                            <button onclick="updateQty(${index}, -1)" class="text-gray-500 hover:text-indigo-600 px-1 font-bold">-</button>
                            <span class="text-sm font-bold w-5 text-center">${item.qty}</span>
                            <button onclick="updateQty(${index}, 1)" class="text-gray-500 hover:text-indigo-600 px-1 font-bold">+</button>
                        </div>
                        <button onclick="removeFromCart(${index})" class="text-red-500 hover:text-red-700 p-2">
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                `;
                container.appendChild(row);
            });

            document.getElementById('cart-total-price').innerText = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        }

        function updateQty(index, change) {
            cart[index].qty += change;
            if(cart[index].qty <= 0) {
                cart.splice(index, 1);
            }
            updateCartBadge();
            renderCartItems();
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartBadge();
            renderCartItems();
            showToast("Produk dihapus dari keranjang.");
        }

        // Checkout Functions
        function checkoutWhatsApp() {
            if(cart.length === 0) {
                showToast("Keranjang masih kosong!", "fa-solid fa-triangle-exclamation text-yellow-400");
                return;
            }

            const paymentMethod = document.getElementById('checkout-payment-method').value;
            let summary = `Halo Admin Rong Ngawi St, saya ingin melakukan pemesanan via web:\n\n`;
            let total = 0;

            cart.forEach((item, i) => {
                let sub = item.price * item.qty;
                total += sub;
                summary += `${i+1}. *${item.name}* (${item.qty} pcs) - Rp ${sub.toLocaleString('id-ID')}\n`;
            });

            summary += `\n*Total Pembayaran:* Rp ${total.toLocaleString('id-ID')}\n`;
            summary += `*Metode Pembayaran:* ${paymentMethod}\n\nMohon proses pesanan ini. Terima kasih!`;

            window.open(`https://wa.me/6282115172928?text=${encodeURIComponent(summary)}`, '_blank');
        }

        function checkoutWeb() {
            if(cart.length === 0) {
                showToast("Keranjang masih kosong!", "fa-solid fa-triangle-exclamation text-yellow-400");
                return;
            }

            const paymentMethod = document.getElementById('checkout-payment-method').value;
            closeCartModal();
            cart = [];
            updateCartBadge();
            showToast(`Pesanan berhasil dibuat dengan metode ${paymentMethod}! Terima kasih telah berbelanja di Rong Ngawi St.`);
        }
    </script>
